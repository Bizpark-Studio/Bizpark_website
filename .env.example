# ===================================================
# BIZPARK STUDIO - ENVIRONMENT VARIABLES TEMPLATE
# ===================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to Git!

# 1. MongoDB Connection String (from MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/bizpark_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bizpark_db?retryWrites=true&w=majority

# 2. Backend Server Port
PORT=5000

# 3. Frontend / Vite URL (for CORS)
CLIENT_URL=http://localhost:5173

# 4. Admin Security Secret Key
ADMIN_SECRET_KEY=bizpark_super_secret_session_key_2026

# 5. Direct Gmail SMTP Dispatch (Optional - for sending emails via Nodemailer)
EMAIL_USER=bizparkstudio@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
